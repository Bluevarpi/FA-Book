  \vspace{4pt}
  {\FAKai\small\color{FASlate}#2\par}
  \vspace{9pt}
  {\color{FARoyal}\rule{0.16\textwidth}{1.8pt}\hspace{6pt}\color{FALine}\rule{0.30\textwidth}{0.6pt}\par}
  \vspace{12pt}
}

\NewDocumentCommand{\FAFrontSubheading}{m}{%
  \par\addvspace{1.15em}\noindent
