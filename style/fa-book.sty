% ---------- Environment system ----------
% R12A geometry invariant: the west accent is the only west border. All visible
% edges belong to the same tcolorbox; no overlay/TikZ seam patches are used.
\tcbset{
  fa/boxbase/.style n args={4}{
    enhanced jigsaw,
    breakable,
    frame hidden,
    boxrule=0pt,
    arc=1.25mm,
    outer arc=1.25mm,
    sharp corners=west,
    colback=#2,
    colbacktitle=#2,
    coltext=FAEnvInk,
    coltitle=#1,
    borderline west={#4}{0pt}{#1},
    borderline north={0.50pt}{0pt}{FABorder},
    borderline east={0.50pt}{0pt}{FABorder},
    borderline south={0.50pt}{0pt}{FABorder},
    left=10pt,right=10pt,top=8.5pt,bottom=8pt,
    before skip=10.5pt,after skip=10.5pt,
    fonttitle=#3,
    halign title=flush left,
    lefttitle=10pt,righttitle=10pt,toptitle=3.2pt,bottomtitle=3.2pt,
    titlerule=0pt
  },
  fa/lightbase/.style n args={3}{
    fa/boxbase={#1}{#2}{\FAKai\bfseries\small}{#3},
    before skip=10pt,after skip=10pt
  },
  fa/example/.style={fa/lightbase={FAExample}{FAExampleBack}{2.60pt}},
  fa/counterexample/.style={fa/lightbase={FACounterexample}{FACounterexampleBack}{2.65pt}},
  fa/remark/.style={fa/lightbase={FARemark}{FARemarkBack}{2.50pt}},
  fa/application/.style={fa/lightbase={FAApplication}{FAApplicationBack}{2.60pt}},
  fa/warning/.style={fa/lightbase={FAWarning}{FAWarningBack}{2.65pt}},
  fa/exercise/.style={fa/boxbase={FAExercise}{FAExerciseBack}{\sffamily\FAHei\bfseries\small}{2.60pt}},
  fa/solution/.style={fa/boxbase={FASolution}{FASolutionBack}{\sffamily\FAHei\bfseries\small}{2.50pt}},
  % Direct priority styles are retained for the reader-guide legend and any
  % existing source that uses fa/A--fa/D without a theorem wrapper.
  fa/A/.style={fa/boxbase={FATheorem}{FATheoremBack}{\sffamily\FAHei\bfseries\small}{2.80pt}},
  fa/B/.style={fa/boxbase={FATheorem!94!white}{FATheoremBack}{\sffamily\FAHei\bfseries\small}{2.70pt}},
  fa/C/.style={fa/boxbase={FATheorem!88!white}{FATheoremBack}{\sffamily\FAHei\bfseries\small}{2.60pt}},
  fa/D/.style={fa/boxbase={FATheorem!82!white}{FATheoremBack}{\sffamily\FAHei\bfseries\small}{2.50pt}},
  fa/front/.style={
    fa/boxbase={FATheorem}{FABack}{\sffamily\FAHei\bfseries\small}{2.70pt},
    left=12pt,right=12pt,top=9pt,bottom=9pt,
    before skip=10pt,after skip=11pt
  }
}

% Formal-result semantic families. Priority changes remain deliberately subtle:
% A/B/C progressively mute the same family accent; D uses a neutral grey-purple.
\def\fa@accent@definition{FADefinition}
\def\fa@back@definition{FADefinitionBack}
\def\fa@accent@theorem{FATheorem}
\def\fa@back@theorem{FATheoremBack}
\def\fa@accent@lemma{FAProposition}
\def\fa@back@lemma{FAPropositionBack}
\def\fa@accent@proposition{FAProposition}
\def\fa@back@proposition{FAPropositionBack}
\def\fa@accent@corollary{FAProposition}
\def\fa@back@corollary{FAPropositionBack}

\newcommand{\fa@preparelevel}[2]{%
  \edef\fa@baseaccent{\csname fa@accent@#1\endcsname}%
  \edef\fa@baseback{\csname fa@back@#1\endcsname}%
  \edef\fa@accent{\fa@baseaccent}%
  \edef\fa@back{\fa@baseback}%
  \def\fa@barwidth{2.80pt}%
  \ifstrequal{#2}{B}{%
    \edef\fa@accent{\fa@baseaccent!94!white}%
    \def\fa@barwidth{2.70pt}%
  }{}%
  \ifstrequal{#2}{C}{%
    \edef\fa@accent{\fa@baseaccent!88!white}%
    \def\fa@barwidth{2.60pt}%
  }{}%
  \ifstrequal{#2}{D}{%
    \edef\fa@accent{\fa@baseaccent!82!white}%
    \def\fa@barwidth{2.50pt}%
  }{}%
}

\def\fa@level@A{A级·主线核心}
\def\fa@level@B{B级·重要支撑}
\def\fa@level@C{C级·局部工具}
\def\fa@level@D{D级·高级选读}
\newcommand{\fa@leveltitle}[1]{\ifcsname fa@level@#1\endcsname\csname fa@level@#1\endcsname\else 未知层级\fi}

% Kept source-compatible for any future direct use of the priority wrapper.
\NewDocumentEnvironment{FAPriorityBox}{m}{%
  \fa@preparelevel{theorem}{#1}%
  \begin{tcolorbox}[fa/boxbase={\fa@accent}{\fa@back}{\sffamily\FAHei\bfseries\small}{\fa@barwidth},title={\fa@leveltitle{#1}}]
}{%
  \end{tcolorbox}
}

\NewDocumentEnvironment{FAStatement}{m O{A} O{} m}{%
  \fa@preparelevel{#1}{#2}%
  \begin{tcolorbox}[fa/boxbase={\fa@accent}{\fa@back}{\sffamily\FAHei\bfseries\small}{\fa@barwidth},title={\fa@leveltitle{#2}}]
  \ifstrempty{#3}{\begin{#1}}{\begin{#1}[#3]}%
  \label{#4}%
}{%
  \end{#1}%
  \end{tcolorbox}%
}

\NewDocumentEnvironment{FADefinition}{O{A} O{} m}{\begin{FAStatement}{definition}[#1][#2]{#3}}{\end{FAStatement}}
\NewDocumentEnvironment{FATheorem}{O{A} O{} m}{\begin{FAStatement}{theorem}[#1][#2]{#3}}{\end{FAStatement}}
\NewDocumentEnvironment{FALemma}{O{A} O{} m}{\begin{FAStatement}{lemma}[#1][#2]{#3}}{\end{FAStatement}}
\NewDocumentEnvironment{FAProposition}{O{A} O{} m}{\begin{FAStatement}{proposition}[#1][#2]{#3}}{\end{FAStatement}}
\NewDocumentEnvironment{FACorollary}{O{A} O{} m}{\begin{FAStatement}{corollary}[#1][#2]{#3}}{\end{FAStatement}}

% Proofs remain unboxed; the explanatory label uses Kai type consistently.
\RenewDocumentEnvironment{proof}{O{证明}}{%
  \par\smallskip\noindent{\FAKai\bfseries\color{FASlate}#1.}\enspace\ignorespaces
}{%
  \par\smallskip
}
\NewDocumentEnvironment{FAProof}{O{证明}}{\begin{proof}[#1]}{\end{proof}}

\NewDocumentEnvironment{FALightBox}{m O{}}{%
  \begin{tcolorbox}[fa/remark,title={#1\ifstrempty{#2}{}{：#2}}]
}{\end{tcolorbox}}
\NewDocumentEnvironment{FAExample}{O{}}{\begin{tcolorbox}[fa/example,title={例\ifstrempty{#1}{}{：#1}}]}{\end{tcolorbox}}
\NewDocumentEnvironment{FACounterexample}{O{}}{\begin{tcolorbox}[fa/counterexample,title={反例\ifstrempty{#1}{}{：#1}}]}{\end{tcolorbox}}
\NewDocumentEnvironment{FARemark}{O{}}{\begin{tcolorbox}[fa/remark,title={注\ifstrempty{#1}{}{：#1}}]}{\end{tcolorbox}}
\NewDocumentEnvironment{FAApplication}{O{}}{\begin{tcolorbox}[fa/application,title={应用\ifstrempty{#1}{}{：#1}}]}{\end{tcolorbox}}
\NewDocumentEnvironment{FAWarning}{O{}}{\begin{tcolorbox}[fa/warning,title={警示\ifstrempty{#1}{}{：#1}}]}{\end{tcolorbox}}

\newcounter{exercise}[section]
\renewcommand{\theexercise}{\thesection.\arabic{exercise}}
\def\exerciseautorefname{习题}
\NewDocumentEnvironment{FAExercise}{O{} m}{%
  \refstepcounter{exercise}\label{#2}%
  \begin{tcolorbox}[fa/exercise,title={习题 \theexercise\ifstrempty{#1}{}{：#1}}]
}{\end{tcolorbox}}
\NewDocumentEnvironment{FASolution}{O{解答}}{\begin{tcolorbox}[fa/solution,title={#1}]}{\end{tcolorbox}}
\NewDocumentEnvironment{FAAnswer}{O{答案}}{\begin{tcolorbox}[fa/solution,title={#1}]}{\end{tcolorbox}}

