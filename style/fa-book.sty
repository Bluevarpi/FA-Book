}

\NewDocumentCommand{\FAVolumeDivider}{m m m m}{%
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{part}{#1·#2}
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture,overlay]
    \fill[FANavy] (current page.south west) rectangle (current page.north east);
    \fill[#4,opacity=.14] ([xshift=-1.5cm,yshift=-1.8cm]current page.north east) circle (4.5cm);
    \draw[#4,opacity=.55,line width=1.2pt] ([yshift=2.2cm]current page.west) -- ([yshift=2.2cm]current page.east);
  \end{tikzpicture}
  \vspace*{0.22\textheight}
  \noindent{\sffamily\FAHei\bfseries\zihao{1}\color{#4}#1\par}
  \vspace{12pt}
  \noindent{\sffamily\FAHei\bfseries\zihao{1}\color{white}#2\par}
  \vspace{16pt}
  \noindent{\FAKai\zihao{-3}\color{white!78}#3\par}
  \vfill
  \noindent{\sffamily\FAHei\small\color{white!62}泛函分析·三卷自学体系\par}
  \clearpage
}

% Custom TOC wrapper with a designed header while preserving standard .toc data.
\makeatletter
\NewDocumentCommand{\FATableOfContents}{}{
  \cleardoublepage
  \phantomsection
  \thispagestyle{plain}
  \markboth{目录}{目录}
  \FAFrontHeading{目录}{三卷结构与阅读路径}
  {\FAKai\small\color{FASlate}
  目录按“卷—章—节—小节”展开. 卷级条目标示三卷主结构，章标题用于快速定位，节与小节保留页码引导；既可按依赖顺序阅读，也可按主题回查.\par}
  \vspace{8pt}
  \@starttoc{toc}
}
